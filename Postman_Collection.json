            },
            "url": {
              "raw": "http://localhost:5000/print",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["print"]
            },
            "description": "Should return error: Invalid priority (must be 'high' or 'normal')"
