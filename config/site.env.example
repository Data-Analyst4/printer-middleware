# Copy this file to config/site.env and edit for this PC/site.
# Used by install.bat (scripts/setup-all.ps1).
#
# Production printer site (recommended for new installs):
#   TUNNEL_NAME=r10-printer
#   PUBLIC_HOSTNAME=r10-printer.k95foods.com
#
# Legacy hostname (old installs):
#   TUNNEL_NAME=r10-print
#   PUBLIC_HOSTNAME=r10-print.k95foods.com

SITE_NAME=R10
TUNNEL_NAME=r10-printer
PUBLIC_HOSTNAME=r10-printer.k95foods.com
PORT=5001
HOST=0.0.0.0
CORS_ORIGINS=*

# Dashboard login — seeds the first admin user into SQLite on startup.
# Leave blank to keep the dashboard open (no login) until users exist.
# After first boot, manage users in the Admin Panel → Users.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me
# SECRET_KEY=replace-with-long-random-string
# Optional machine/ERP access when dashboard login is enabled:
# API_KEY=change-me

# Camera import (v1.2.0 Immediate camera import)
# Per-request camera_import.url from ERP overrides CAMERA_IMPORT_BATCH_URL.
CAMERA_IMPORT_ENABLED=true
CAMERA_IMPORT_BATCH_URL=http://192.168.0.68:5001/api/import_batch
CAMERA_IMPORT_TIMEOUT=3
# immediate = POST before printer send (default). rqlp = legacy after-print confirm.
CAMERA_IMPORT_FLOW=immediate

# Bulk Mode A (v1.4.0): POST /print with pod_data + count
PRINT_CHUNK_SIZE=30
PRINT_CHUNK_PAUSE_MS=400
PRINT_BULK_MAX_COUNT=100000
# v1.4.1: keep the same job alive after timeout/NYES/TCP drop (RQLP leftover + STAR)
PRINT_BULK_RESUME=true
PRINT_BULK_DATA_RETRIES=3
PRINT_BULK_RECOVER_MAX=20
PRINT_BULK_STAR_RETRIES=3

