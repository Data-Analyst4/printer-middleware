# Copy this file to config/site.env and edit for this PC/site.
# Used by install.bat (scripts/setup-all.ps1).
#
# Production printer site (recommended for new installs):
#   TUNNEL_NAME=r10-printer
#   PUBLIC_HOSTNAME=r10-printer.k95foods.com
#
# Legacy hostname (old installs):
#   TUNNEL_NAME=r10-print
#   PUBLIC_HOSTNAME=r10-print.k95foods.com

SITE_NAME=R10
TUNNEL_NAME=r10-printer
PUBLIC_HOSTNAME=r10-printer.k95foods.com
PORT=5001
HOST=0.0.0.0
CORS_ORIGINS=*
