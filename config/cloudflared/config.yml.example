# Replace all placeholder values before use:
# - tunnel: your real tunnel UUID
# - credentials-file: JSON generated by `cloudflared tunnel create`
# - hostname: your real DNS hostname
tunnel: 12345678-90ab-cdef-1234-567890abcdef
credentials-file: C:\Users\DELL\.cloudflared\12345678-90ab-cdef-1234-567890abcdef.json
ingress:
  - hostname: print.example.com      # use your real hostname
    service: http://127.0.0.1:5000   # your Flask app
  - service: http_status:404
